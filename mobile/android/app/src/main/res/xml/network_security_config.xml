<?xml version="1.0" encoding="utf-8"?>
<!-- The API is typically served over plain HTTP on a LAN / emulator during
     development. HTTPS is still preferred when available. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
